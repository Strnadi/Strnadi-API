# Tenant runtime, Infisical selected environment /tenant.
ASPNETCORE_ENVIRONMENT=Production
ConnectionStrings__Default=REQUIRED_TENANT_DATABASE
Encryption__Key=REQUIRED_EXISTING_BASE64_AES_KEY
Administration__Authority=https://preprod-administration.strnadi.cz
Administration__ProjectId=REQUIRED_PROJECT_UUID
CORS__Default=Default
Host=https://preprod-api.strnadi.cz
Storage__RootPath=/var/lib/strnadi/storage
Firebase__ServiceAccountJson=REQUIRED_SINGLE_LINE_JSON
MapyCz__Key=REQUIRED
Classification__BaseUrl=REQUIRED_CLASSIFICATION_SERVICE_URL
ReverseProxy__KnownProxies__0=REQUIRED_PROXY_IP
