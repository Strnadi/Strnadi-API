# Runtime secrets belong in Infisical /administration in the selected environment.
# All hosted environments use persistent certificates, including dev.
ASPNETCORE_ENVIRONMENT=Production
ConnectionStrings__Default=REQUIRED_ADMINISTRATION_DATABASE
Encryption__Key=REQUIRED_BASE64_AES_KEY
Auth__Google__ClientId=REQUIRED
Auth__Google__ClientSecret=REQUIRED
Auth__Apple__ClientId=REQUIRED
Auth__Apple__TeamId=REQUIRED
Auth__Apple__KeyId=REQUIRED
Auth__Apple__P8PrivateKey=REQUIRED
Smtp__Domain=REQUIRED
Smtp__Username=REQUIRED
Smtp__Password=REQUIRED
Smtp__Port=587
Smtp__Email=REQUIRED
Smtp__EnableSsl=true
OAuth__Signing__Pfx=REQUIRED_BASE64_PKCS12
OAuth__Signing__Password=REQUIRED
OAuth__Encryption__Pfx=REQUIRED_BASE64_PKCS12
OAuth__Encryption__Password=REQUIRED
DataProtection__KeysPath=/var/lib/strnadi/keys
# Exact stable Traefik source address, not a client address or an entire network.
ReverseProxy__KnownProxies__0=REQUIRED_PROXY_IP

Storage__RootPath=/var/lib/strnadi/storage
