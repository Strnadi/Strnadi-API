
pipeline {
    agent {
        label 'container-build'
    }

    options {
        skipDefaultCheckout()
        timestamps()
        timeout(time: 45, unit: 'MINUTES')
    }

    environment {
        APPLICATION = 'strnadi-api'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm

                script {
                    env.RESOLVED_GIT_SHA = sh(
                        script: 'git rev-parse HEAD',
                        returnStdout: true
                    ).trim()

                    if (!(env.RESOLVED_GIT_SHA ==~ /[0-9a-f]{40}/)) {
                        error('Unable to resolve the complete Git SHA.')
                    }
                }
            }
        }

        stage('Validate build contract') {
            steps {
                sh '''
                    set -eu

                    test -f Dockerfile
                    test -f deployment/compose.yaml
                    test -f deployment/env.example

                    test -f deployment/administration.compose.yaml
                    test -f deployment/administration.env.example

                    docker buildx version
                    docker buildx inspect --bootstrap
                '''
            }
        }

        stage('Test') {
            steps {
                sh '''
                    set -eu

                    docker buildx build \
                      --pull \
                      --progress=plain \
                      --target test \
                      --output=type=cacheonly \
                      .

                    docker buildx build \
                      --pull --progress=plain --target administration-test \
                      --output=type=cacheonly .
                '''
            }
        }

        stage('Validate production image') {
            steps {
                sh '''
                    set -eu

                    docker buildx build \
                      --progress=plain \
                      --target final \
                      --output=type=cacheonly \
                      .

                    docker buildx build \
                      --progress=plain --target administration-final \
                      --output=type=cacheonly .
                '''
            }
        }

        // Publication and deployment are owned by the trusted infrastructure
        // pipeline: StrnadiAPI/{tenant|administration}/{dev|preprod|production}.
    }

    post {
        always {
            deleteDir()
        }
    }
}
