# Copy this file to ".env.development" (same folder) and fill in real values.
# Program.cs loads ".env.development" into the process environment on startup, and
# ASP.NET Core's built-in environment-variable provider maps a double underscore to a
# config-section separator, e.g. Auth__Google__Android becomes the config key
# "Auth:Google:Android".

ASPNETCORE_ENVIRONMENT=Development

# --- Google auth (same upstream app registrations as Tenant.Api's .env.example) ---
Auth__Google__Android=
Auth__Google__Ios=
Auth__Google__Web=
Auth__Google__WebSecret=

# --- Apple auth (same upstream app registrations as Tenant.Api's .env.example) ---
Auth__Apple__TeamId=
Auth__Apple__KeyId=
Auth__Apple__ClientIdWeb=
Auth__Apple__ClientIdIos=
Auth__Apple__RedirectUriWeb=
Auth__Apple__P8PrivateKey=