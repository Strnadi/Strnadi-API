@using Administration.Api.TagHelpers
@model Administration.Api.Pages.Dashboard.UsersTableViewModel
@{
    var searchFields = new List<SsTableSearchField> { new("name", L["Name"].Value) };
    if (Model.CanViewUsersConfidential)
        searchFields.Add(new("email", L["Email"].Value));

    var columnCount = 5 + (Model.CanViewUsersConfidential ? 3 : 0) + (Model.CanManageUsers ? 1 : 0);
}

<ss-table search-name="Search" search-value="@Model.Search" search-placeholder="@L["Search"].Value" search-button-text="@L["Search"].Value"
          search-field-name="SearchField" search-field-value="@Model.SearchField" search-fields="@searchFields">
    <thead>
        <tr>
            <th>@L["FirstName"] / @L["LastName"]</th>
            @if (Model.CanViewUsersConfidential)
            {
                <th>@L["Email"]</th>
                <th>@L["City"]</th>
                <th>@L["PostCode"]</th>
            }
            <th>@L["RegisteredAt"]</th>
            <th>@L["Status"]</th>
            <th>@L["Legacy"]</th>
            <th>@L["EmailConfirmed"]</th>
            @if (Model.CanManageUsers)
            {
                <th></th>
            }
        </tr>
    </thead>
    <tbody>
        @if (Model.Users.Count == 0)
        {
            <tr><td colspan="@columnCount" style="color:var(--color-text-muted);font-size:var(--font-size-sm);">@L["NoUsers"]</td></tr>
        }
        else
        {
            @foreach (var user in Model.Users)
            {
                <tr>
                    <td>@user.FirstName @user.LastName</td>
                    @if (Model.CanViewUsersConfidential)
                    {
                        <td>@user.Email</td>
                        <td>@user.City</td>
                        <td>@user.PostCode</td>
                    }
                    <td>@user.CreatedAt.ToString("d")</td>
                    <td>
                        @if (user.Deleted)
                        {
                            <span class="ss-badge ss-badge--danger">@L["Deleted"]</span>
                        }
                        else
                        {
                            <span class="ss-badge ss-badge--success">@L["Active"]</span>
                        }
                    </td>
                    <td>
                        @if (user.Legacy)
                        {
                            <span class="ss-badge ss-badge--warning">@L["Legacy"]</span>
                        }
                    </td>
                    <td>
                        @if (user.EmailConfirmed)
                        {
                            <span class="ss-badge ss-badge--success">@L["Confirmed"]</span>
                        }
                        else
                        {
                            <span class="ss-badge ss-badge--warning">@L["Unconfirmed"]</span>
                        }
                    </td>
                    @if (Model.CanManageUsers)
                    {
                        <td><a class="ss-btn ss-btn--ghost ss-btn--sm" href="/dashboard/users/@user.Id/edit">@L["Edit"]</a></td>
                    }
                </tr>
            }
        }
    </tbody>
</ss-table>
