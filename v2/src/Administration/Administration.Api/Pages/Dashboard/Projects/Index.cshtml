@page "/dashboard/projects"
@using Administration.Api.TagHelpers
@using Administration.Domain.Entities.Enums
@model Administration.Api.Pages.Dashboard.Projects.IndexModel
@{
    ViewData["Title"] = L["Projects"].Value;
    var searchFields = new List<SsTableSearchField>
    {
        new("name", L["Name"].Value),
        new("domain", L["Domain"].Value)
    };
}

<h1>@L["Projects"]</h1>

<div class="ss-card">
    <ss-table create-href="/dashboard/projects/create" create-text="@L["NewProject"].Value"
              search-name="Search" search-value="@Model.Search" search-placeholder="@L["Search"].Value"
              search-field-name="SearchField" search-field-value="@Model.SearchField" search-fields="@searchFields">
        <thead>
            <tr>
                <ss-th sort="name">@L["Projects"]</ss-th>
                <ss-th sort="domain">@L["Domain"]</ss-th>
                <ss-th sort="status">@L["Status"]</ss-th>
            </tr>
        </thead>
        <tbody>
            @if (Model.ProjectList.Count == 0)
            {
                <tr><td colspan="3" style="color:var(--color-text-muted);font-size:var(--font-size-sm);">@L["NoProjects"]</td></tr>
            }
            else
            {
                @foreach (var project in Model.ProjectList)
                {
                    var status = StatusBadge(project.State);
                    <tr>
                        <td><a href="/dashboard/projects/@project.Id">@project.Name</a></td>
                        <td>@project.Domain</td>
                        <td><span class="ss-badge @status.Modifier">@L[status.LabelKey]</span></td>
                    </tr>
                }
            }
        </tbody>
    </ss-table>
</div>

@functions {
    private (string Modifier, string LabelKey) StatusBadge(ProjectState state) => state switch
    {
        ProjectState.Active => ("ss-badge--success", "Active"),
        ProjectState.Draft => ("", "Draft"),
        ProjectState.Archived => ("ss-badge--warning", "Archived"),
        ProjectState.Deactivated => ("ss-badge--warning", "Deactivated"),
        ProjectState.Deleted => ("ss-badge--danger", "Deleted"),
        ProjectState.Rejected => ("ss-badge--danger", "Rejected"),
        _ => ("", state.ToString())
    };
}
