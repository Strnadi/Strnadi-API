@page "/dashboard/projects/{id:guid}"
@using Administration.Domain.Entities.Enums
@model Administration.Api.Pages.Dashboard.Projects.DetailsModel
@{
    ViewData["Title"] = Model.Project.Name;
    var status = StatusBadge(Model.Project.State);
}

<h1>@Model.Project.Name</h1>

<div style="display:flex;gap:var(--space-2);">
    @if (Model.CanManageProjects)
    {
        <a class="ss-btn ss-btn--secondary ss-btn--sm" href="/dashboard/projects/@Model.Project.Id/edit">@L["Edit"]</a>
    }
    @if (Model.CanManageRolesHere)
    {
        <a class="ss-btn ss-btn--secondary ss-btn--sm" href="/dashboard/projects/@Model.Project.Id/roles">@L["Roles"]</a>
    }
</div>

<div class="ss-stack">
    <div class="ss-card">
        <h2>@L["YourRoles"]</h2>
        @if (Model.RoleNames.Count == 0)
        {
            <p style="color:var(--color-text-muted);font-size:var(--font-size-sm);">@L["NoRoleInThisProject"]</p>
        }
        @foreach (var role in Model.RoleNames)
        {
            <span class="ss-badge">@role</span>
        }
    </div>

    <div class="ss-card">
        @if (Model.Project.PhotoPath is not null)
        {
            <img src="/dashboard/projects/@Model.Project.Id?handler=Logo" alt="@Model.Project.Name" style="max-width:120px;max-height:120px;border-radius:var(--radius-md);margin-bottom:var(--space-4);" />
        }

        @if (!string.IsNullOrEmpty(Model.Project.Description))
        {
            <p>@Model.Project.Description</p>
        }

        <p>@L["Domain"]: @Model.Project.Domain</p>
        @if (!string.IsNullOrEmpty(Model.Project.ApiDomain))
        {
            <p>@L["ApiDomain"]: @Model.Project.ApiDomain</p>
        }
        <p>@L["Status"]: <span class="ss-badge @status.Modifier">@L[status.LabelKey]</span></p>

        @if (Model.CreatedByName is not null)
        {
            <p>@L["CreatedBy"]: @Model.CreatedByName (@Model.Project.CreatedAt.ToString("d"))</p>
        }

        @if (Model.Project.State == ProjectState.Rejected && !string.IsNullOrEmpty(Model.Project.RejectionReason))
        {
            <div class="ss-alert ss-alert--danger">@Model.Project.RejectionReason</div>
        }
    </div>

    @if (Model.CanManageProjects && !string.IsNullOrEmpty(Model.Project.ApiDomain))
    {
        <div class="ss-card">
            <h2 class="ss-section-heading">@L["ApiCompatibility"]</h2>

            <h3>@L["Capabilities"]</h3>
            @if (Model.Project.CapabilitiesCheckedAt is null)
            {
                <p style="color:var(--color-text-muted);font-size:var(--font-size-sm);">@L["NotCheckedYet"]</p>
            }
            else
            {
                <div class="ss-consent-item__badges" style="margin-bottom:var(--space-2);">
                    @foreach (var feature in Model.DeclaredFeatures)
                    {
                        <span class="ss-badge ss-badge--success">@feature</span>
                    }
                    @foreach (var feature in Model.MissingFeatures)
                    {
                        <span class="ss-badge ss-badge--warning" title="@L["MissingFeatureHint"]">@feature</span>
                    }
                </div>
                <p style="color:var(--color-text-muted);font-size:var(--font-size-sm);">@L["CheckedAt"]: @Model.Project.CapabilitiesCheckedAt.Value.ToString("d")</p>
            }
            <form method="post" asp-page-handler="RefreshCapabilities">
                <button type="submit" class="ss-btn ss-btn--secondary ss-btn--sm">@L["RefreshCapabilities"]</button>
            </form>

            <h3 style="margin-top:var(--space-5);">@L["ApiConformance"]</h3>
            @if (Model.Project.ApiConformanceCheckedAt is null)
            {
                <p style="color:var(--color-text-muted);font-size:var(--font-size-sm);">@L["NotCheckedYet"]</p>
            }
            else if (string.IsNullOrEmpty(Model.Project.ApiConformanceReport))
            {
                <p><span class="ss-badge ss-badge--success">@L["FullyCompatible"]</span></p>
            }
            else
            {
                <div class="ss-alert ss-alert--warning">
                    <ul style="margin:0;padding-left:1.2em;">
                        @foreach (var line in Model.Project.ApiConformanceReport.Split('\n', StringSplitOptions.RemoveEmptyEntries))
                        {
                            <li>@line</li>
                        }
                    </ul>
                </div>
            }
            @if (Model.Project.ApiConformanceCheckedAt is not null)
            {
                <p style="color:var(--color-text-muted);font-size:var(--font-size-sm);">@L["CheckedAt"]: @Model.Project.ApiConformanceCheckedAt.Value.ToString("d")</p>
            }
            <form method="post" asp-page-handler="CheckApiConformance">
                <button type="submit" class="ss-btn ss-btn--secondary ss-btn--sm">@L["CheckApiCompatibility"]</button>
            </form>
        </div>
    }
</div>

@functions {
    private (string Modifier, string LabelKey) StatusBadge(ProjectState state) => state switch
    {
        ProjectState.Active => ("ss-badge--success", "Active"),
        ProjectState.Draft => ("", "Draft"),
        ProjectState.Archived => ("ss-badge--warning", "Archived"),
        ProjectState.Deactivated => ("ss-badge--warning", "Deactivated"),
        ProjectState.Deleted => ("ss-badge--danger", "Deleted"),
        ProjectState.Rejected => ("ss-badge--danger", "Rejected"),
        _ => ("", state.ToString())
    };
}
