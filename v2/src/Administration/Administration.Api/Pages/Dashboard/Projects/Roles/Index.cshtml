@page "/dashboard/projects/{projectId:guid}/roles"
@model Administration.Api.Pages.Dashboard.Projects.Roles.IndexModel
@{
    ViewData["Title"] = L["Roles"].Value;
}

<a href="/dashboard/projects/@Model.Project.Id">&larr; @Model.Project.Name</a>

<div style="display:flex;align-items:center;justify-content:space-between;gap:var(--space-4);margin-bottom:var(--space-4);">
    <h1 style="margin:0;">@L["Roles"]</h1>
    <a class="ss-btn ss-btn--primary" href="/dashboard/projects/@Model.Project.Id/roles/create">@L["NewRole"]</a>
</div>

<div class="ss-card">
    @if (Model.RoleList.Count == 0)
    {
        <p>@L["NoRoles"]</p>
    }
    else
    {
        <ss-table>
            <thead>
                <tr>
                    <th>@L["Name"]</th>
                    <th>@L["Permissions"]</th>
                    <th>@L["Members"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var role in Model.RoleList)
                {
                    <tr>
                        <td>
                            @role.Name
                            @if (!string.IsNullOrEmpty(role.Description))
                            {
                                <div style="color:var(--color-text-muted);font-size:var(--font-size-sm);">@role.Description</div>
                            }
                        </td>
                        <td>@role.PermissionCount</td>
                        <td>@role.MemberCount</td>
                        <td>
                            <a class="ss-btn ss-btn--ghost ss-btn--sm" href="/dashboard/projects/@Model.Project.Id/roles/@role.Id/edit">@L["Edit"]</a>
                        </td>
                    </tr>
                }
            </tbody>
        </ss-table>
    }
</div>
