@page "/dashboard"
@model Administration.Api.Pages.Dashboard.IndexModel
@{
    ViewData["Title"] = L["MyAccount"].Value;
}

<h1>@L["MyAccount"]</h1>

<div class="ss-stack">
    <div class="ss-card">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="ss-alert ss-alert--danger"></div>

            <div class="ss-field">
                <label asp-for="Input.Email" class="ss-field__label">@L["Email"]</label>
                <input asp-for="Input.Email" class="ss-field__input" />
                <span asp-validation-for="Input.Email" class="ss-field__error"></span>
            </div>
            <div class="ss-field">
                <label asp-for="Input.UserName" class="ss-field__label">@L["UserName"]</label>
                <input asp-for="Input.UserName" class="ss-field__input" />
                <span asp-validation-for="Input.UserName" class="ss-field__error"></span>
            </div>
            <div class="ss-field-row">
                <div class="ss-field">
                    <label asp-for="Input.FirstName" class="ss-field__label">@L["FirstName"]</label>
                    <input asp-for="Input.FirstName" class="ss-field__input" />
                    <span asp-validation-for="Input.FirstName" class="ss-field__error"></span>
                </div>
                <div class="ss-field">
                    <label asp-for="Input.LastName" class="ss-field__label">@L["LastName"]</label>
                    <input asp-for="Input.LastName" class="ss-field__input" />
                    <span asp-validation-for="Input.LastName" class="ss-field__error"></span>
                </div>
            </div>
            <div class="ss-field-row">
                <div class="ss-field">
                    <label asp-for="Input.City" class="ss-field__label">@L["City"]</label>
                    <input asp-for="Input.City" class="ss-field__input" />
                    <span asp-validation-for="Input.City" class="ss-field__error"></span>
                </div>
                <div class="ss-field">
                    <label asp-for="Input.PostCode" class="ss-field__label">@L["PostCode"]</label>
                    <input asp-for="Input.PostCode" class="ss-field__input" />
                    <span asp-validation-for="Input.PostCode" class="ss-field__error"></span>
                </div>
            </div>

            <button type="submit" class="ss-btn ss-btn--primary">@L["Save"]</button>
        </form>
    </div>

    <div class="ss-card">
        <h2>@L["ChangePassword"]</h2>
        <form method="post" asp-page-handler="ChangePassword">
            <div asp-validation-summary="ModelOnly" class="ss-alert ss-alert--danger"></div>

            <div class="ss-field">
                <label asp-for="PasswordInput.CurrentPassword" class="ss-field__label">@L["CurrentPassword"]</label>
                <input asp-for="PasswordInput.CurrentPassword" type="password" class="ss-field__input" autocomplete="current-password" />
                <span asp-validation-for="PasswordInput.CurrentPassword" class="ss-field__error"></span>
            </div>
            <div class="ss-field-row">
                <div class="ss-field">
                    <label asp-for="PasswordInput.NewPassword" class="ss-field__label">@L["NewPassword"]</label>
                    <input asp-for="PasswordInput.NewPassword" type="password" class="ss-field__input" autocomplete="new-password" />
                    <span asp-validation-for="PasswordInput.NewPassword" class="ss-field__error"></span>
                </div>
                <div class="ss-field">
                    <label asp-for="PasswordInput.ConfirmNewPassword" class="ss-field__label">@L["ConfirmPassword"]</label>
                    <input asp-for="PasswordInput.ConfirmNewPassword" type="password" class="ss-field__input" autocomplete="new-password" />
                    <span asp-validation-for="PasswordInput.ConfirmNewPassword" class="ss-field__error"></span>
                </div>
            </div>

            <button type="submit" class="ss-btn ss-btn--primary">@L["ChangePassword"]</button>
        </form>
    </div>
</div>
