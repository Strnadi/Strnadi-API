@page "/account/forgot-password-request"
@model Administration.Api.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = L["ForgotPassword"].Value;
}

<div class="ss-auth-shell">
    <div class="ss-auth-wordmark">Strnadi</div>

    <div class="ss-card ss-auth-card">
        <h1>@L["ForgotPassword"]</h1>

        @if (Model.LinkSent)
        {
            <div class="ss-alert ss-alert--success">@L["ResetLinkSentMessage"]</div>
        }
        else
        {
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="ss-alert ss-alert--danger"></div>

                <div class="ss-field">
                    <label asp-for="Input.Email" class="ss-field__label">@L["Email"]</label>
                    <input asp-for="Input.Email" class="ss-field__input" autofocus />
                    <span asp-validation-for="Input.Email" class="ss-field__error"></span>
                </div>

                <button type="submit" class="ss-btn ss-btn--primary">@L["SendResetLink"]</button>
            </form>
        }

        <div class="ss-auth-footer">
            <a href="/account/login">@L["Login"]</a>
        </div>
    </div>
</div>
