@page "/account/reset-password"
@model Administration.Api.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = L["ResetPassword"].Value;
}

<div class="ss-auth-shell">
    <div class="ss-auth-wordmark">Strnadi</div>

    <div class="ss-card ss-auth-card">
        <h1>@L["ResetPassword"]</h1>

        <form method="post">
            <input type="hidden" asp-for="Email" />
            <input type="hidden" asp-for="Token" />
            <div asp-validation-summary="ModelOnly" class="ss-alert ss-alert--danger"></div>

            <div class="ss-field">
                <label asp-for="Input.NewPassword" class="ss-field__label">@L["NewPassword"]</label>
                <input asp-for="Input.NewPassword" type="password" class="ss-field__input" />
                <span asp-validation-for="Input.NewPassword" class="ss-field__error"></span>
            </div>
            <div class="ss-field">
                <label asp-for="Input.ConfirmPassword" class="ss-field__label">@L["ConfirmPassword"]</label>
                <input asp-for="Input.ConfirmPassword" type="password" class="ss-field__input" />
                <span asp-validation-for="Input.ConfirmPassword" class="ss-field__error"></span>
            </div>

            <button type="submit" class="ss-btn ss-btn--primary">@L["ResetPassword"]</button>
        </form>
    </div>
</div>
