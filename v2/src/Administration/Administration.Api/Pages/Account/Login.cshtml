@page
@model Administration.Api.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Login";
}

<h1>Login</h1>

<form method="post">
    <input type="hidden" asp-for="ReturnUrl" />
    <div asp-validation-summary="All"></div>
    <div>
        <label asp-for="Input.Email"></label>
        <input asp-for="Input.Email" />
        <span asp-validation-for="Input.Email"></span>
    </div>
    <div>
        <label asp-for="Input.Password"></label>
        <input asp-for="Input.Password" type="password" />
        <span asp-validation-for="Input.Password"></span>
    </div>
    <button type="submit">Login</button>
</form>

@* Google/Apple buttons go here once the external-login challenge/callback endpoints exist. *@

<a href="/account/register?returnUrl=@Uri.EscapeDataString(Model.ReturnUrl ?? "")">No account? Register</a>