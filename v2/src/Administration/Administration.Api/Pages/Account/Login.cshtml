@page
@model Administration.Api.Pages.Account.LoginModel
@{
    ViewData["Title"] = L["Login"].Value;
}

<div class="ss-auth-shell">
    <div class="ss-auth-wordmark">Strnadi</div>

    <div class="ss-card ss-auth-card">
        <h1>@L["Login"]</h1>

        <partial name="_ExternalProviders" model="Model.ReturnUrl" />

        <form method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="ss-alert ss-alert--danger"></div>

            <div class="ss-field">
                <label asp-for="Input.Email" class="ss-field__label">@L["Email"]</label>
                <input asp-for="Input.Email" class="ss-field__input" />
                <span asp-validation-for="Input.Email" class="ss-field__error"></span>
            </div>
            <div class="ss-field">
                <label asp-for="Input.Password" class="ss-field__label">@L["Password"]</label>
                <input asp-for="Input.Password" type="password" class="ss-field__input" />
                <span asp-validation-for="Input.Password" class="ss-field__error"></span>
            </div>

            <button type="submit" class="ss-btn ss-btn--primary">@L["Login"]</button>
        </form>

        <div class="ss-auth-footer">
            @L["NoAccount"] <a href="/account/register?returnUrl=@Uri.EscapeDataString(Model.ReturnUrl ?? "")">@L["Register"]</a>
        </div>
    </div>
</div>
