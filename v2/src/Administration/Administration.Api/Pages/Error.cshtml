@page "/error/{code:int}"
@model Administration.Api.Pages.ErrorModel
@{
    ViewData["Title"] = L[Model.HeadingKey].Value;
}

<div class="ss-auth-shell">
    <div class="ss-auth-wordmark">Strnadi</div>

    <div class="ss-card ss-auth-card">
        <h1>@L[Model.HeadingKey]</h1>
        @if (Model.MessageKey is not null)
        {
            <p>@L[Model.MessageKey]</p>
        }
        <a class="ss-btn ss-btn--primary" href="/">@L["BackToHome"]</a>
    </div>
</div>
