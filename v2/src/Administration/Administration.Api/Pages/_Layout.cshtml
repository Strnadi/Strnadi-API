@using System.Globalization
@{
    var title = ViewData["Title"] as string ?? "Strnadi";
    var currentCulture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}
<!DOCTYPE html>
<html lang="@currentCulture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title — Strnadi</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/design-system.css" />
</head>
<body>
    <div class="ss-lang-switch">
        <a class="ss-lang-switch__item@(currentCulture == "cs" ? " ss-lang-switch__item--active" : "")"
           href="/culture/set?culture=cs&returnUrl=@Uri.EscapeDataString(returnUrl)">CS</a>
        <a class="ss-lang-switch__item@(currentCulture == "en" ? " ss-lang-switch__item--active" : "")"
           href="/culture/set?culture=en&returnUrl=@Uri.EscapeDataString(returnUrl)">EN</a>
    </div>
    @RenderBody()
</body>
</html>
