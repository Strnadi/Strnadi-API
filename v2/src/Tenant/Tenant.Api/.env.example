# Copy this file to ".env" (same folder) and fill in real values.
# Program.cs loads ".env" into the process environment on startup, and
# ASP.NET Core's built-in environment-variable provider maps a double
# underscore to a config-section separator, e.g. Jwt__SecretKey becomes
# the config key "Jwt:SecretKey".

ASPNETCORE_ENVIRONMENT=Development

# --- Database (Tenant.Infrastructure/Configuration/DatabaseSettings.cs) ---
ConnectionStrings__Default=Host=localhost;Port=5432;Database=strnadi;Username=postgres;Password=postgres

# --- Administration (ProjectSettings.cs) — where tokens are issued/validated from, and which
# Project this Tenant deployment serves (must match a Project.Domain in Administration's DB) ---
Administration__Authority=https://localhost:5443
Administration__ProjectId=

# --- CORS (CorsSettings.cs) — name of the CORS policy to apply ---
CORS__Default=Default

# --- Host (HostSettings.cs) ---
Host=https://localhost:5001

# --- File storage (LocalStorageSettings.cs) ---
# Optional; defaults to the app's base directory when unset.
#Storage__RootPath=/var/strnadi/storage

# --- Firebase (FirebaseSettings.cs) ---
Firebase__ServiceAccountJson=

# --- Mapy.cz (MapyCzSettings.cs) ---
MapyCz__Key=

# --- Dialect classification AI service (ClassificationSettings.cs) ---
# External service, not part of this repo/Aspire graph.
Classification__BaseUrl=http://localhost:8000

# --- Field-level encryption at rest (EncryptionSettings.cs) ---
# Base64-encoded AES key (32 random bytes for AES-256), e.g.: openssl rand -base64 32
# Rotating this key makes all previously-encrypted columns unreadable — treat it like any
# other long-lived secret (per-environment, never reused between dev/staging/prod).
Encryption__Key=
