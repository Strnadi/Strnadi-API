 confirmed_dialect          | character varying(15)       |           |          |         | extended | 
View definition:
 SELECT users.first_name,
    users.last_name,
    recordings.id AS recording_id,
    recording_parts.id AS recording_parts_id,
    recording_parts.start_date,
    recording_parts.end_date,
    recording_parts.gps_latitude_start,
    recording_parts.gps_longitude_start,
    recording_parts.file_path,
    filtered_recording_parts.id AS filtered_recording_part_id,
    filtered_recording_parts.probability_vector,
    filtered_recording_parts.start_date AS filtered_start_date,
    filtered_recording_parts.end_date AS filtered_end_date,
    guess.dialect_code AS guess_dialect,
    confirmed.dialect_code AS confirmed_dialect
   FROM recordings
     LEFT JOIN recording_parts ON recordings.id = recording_parts.recording_id
     LEFT JOIN users ON recordings.user_id = users.id
     LEFT JOIN filtered_recording_parts ON recordings.id = filtered_recording_parts.recording_id
     LEFT JOIN detected_dialects ON detected_dialects.filtered_recording_part_id = filtered_recording_parts.id
     LEFT JOIN dialects guess ON guess.id = detected_dialects.user_guess_dialect_id
     LEFT JOIN dialects confirmed ON confirmed.id = detected_dialects.confirmed_dialect_id
  ORDER BY recording_parts.id DESC, recordings.id DESC, recording_parts.start_date DESC;

